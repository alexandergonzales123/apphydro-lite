# Copia este fichero a .env (junto a docker-compose.yml) y ajusta los valores.
# .env está en .gitignore: no lo subas al repositorio.

# Clave que la app envía en la cabecera X-API-Key (EXPO_PUBLIC_API_KEY en la app).
# Genera una aleatoria, p. ej.: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=cambia-esto-por-una-clave-aleatoria

# development | production. Con production la API no arranca si API_KEY está vacía
# o es "dev-key-cambiar".
ENV=development

# 1 = expone /docs, /redoc y /openapi.json. Ponlo a 0 fuera de desarrollo.
ENABLE_DOCS=1

# Credenciales de PostGIS (Postgres sólo se publica en 127.0.0.1:POSTGRES_HOST_PORT).
POSTGRES_DB=infra
POSTGRES_USER=infra
POSTGRES_PASSWORD=infra

# Puerto del host (sólo 127.0.0.1) para Postgres. Cámbialo si 5432 ya está ocupado.
POSTGRES_HOST_PORT=5432
