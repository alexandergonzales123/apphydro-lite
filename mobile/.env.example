# Copia este fichero a .env (no se sube a git).
# URL base de la API, sin barra final. En local: http://<IP-de-tu-PC-en-la-LAN>:8000
# (no uses localhost: el móvil no es tu PC). En builds de release (production y la APK
# preview) debe ser HTTPS (RNF-L06; iOS y Android bloquean HTTP en release).
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
# API key fija de la app (cabecera X-API-Key). Clave de desarrollo del backend:
EXPO_PUBLIC_API_KEY=dev-key-cambiar
